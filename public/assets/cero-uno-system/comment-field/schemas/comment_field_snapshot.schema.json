{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cero Uno Comment Field Snapshot",
  "type": "object",
  "required": [
    "schema_version",
    "snapshot_id",
    "field_summary",
    "dominant_families",
    "creator_suggestions",
    "aemp_tensions",
    "safety_rules"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "snapshot_id": {
      "type": "string"
    },
    "field_summary": {
      "type": "string"
    },
    "dominant_families": {
      "type": "array"
    },
    "creator_suggestions": {
      "type": "object"
    },
    "aemp_tensions": {
      "type": "array"
    },
    "platform_directives": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "safety_rules": {
      "type": "object"
    }
  }
}